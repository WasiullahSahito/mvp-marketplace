# Web (web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Server-side only. Optional: without it the AI feature returns a labelled mock result.
# Gemini API key from Google AI Studio. GEMINI_MODEL is optional (must accept images).
GEMINI_API_KEY=
GEMINI_MODEL=

# Mobile (mobile/.env)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# NEVER put the Supabase service-role key in any client or in this repo.
