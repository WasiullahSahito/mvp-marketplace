# Web (web/.env.local)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Server-side only. Optional: without it the AI feature returns a labelled mock result.
# Ollama Cloud API key (create it in your Ollama account). OLLAMA_MODEL must be a vision model (default gemma4:31b).
# For a local Ollama instead: OLLAMA_BASE_URL=http://localhost:11434 (no key needed).
OLLAMA_API_KEY=
OLLAMA_MODEL=

# Mobile (mobile/.env)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# NEVER put the Supabase service-role key in any client or in this repo.
